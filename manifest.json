{
  "manifest_version": 3,
  "name": "GLaDOS 多账号签到助手",
  "short_name": "签到助手",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "非官方工具。在同一 Chrome 配置中多账号签到、优先攒 500 分并按有效期自动兑换天数，最后恢复原账号。",
  "permissions": ["alarms", "storage", "scripting", "notifications"],
  "host_permissions": ["https://glados.cloud/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "GLaDOS 多账号签到", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
